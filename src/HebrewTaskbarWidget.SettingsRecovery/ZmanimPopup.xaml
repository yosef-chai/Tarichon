<Window x:Class="HebrewTaskbarWidget.ZmanimPopup"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:HebrewTaskbarWidget.Controls"
        Title="זמני היום ההלכתיים"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="Manual"
        Width="346" Height="720"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        Deactivated="ZmanimPopup_Deactivated"
        PreviewKeyDown="Window_PreviewKeyDown">

    <!-- אותה ערכת עיצוב כמו חלון ההגדרות; ApplyTheme ב-code-behind מחליף בין בהיר לכהה. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HebrewTaskbarWidget;component/Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- שורת זמן. הזמן הקרוב (רק כשמוצג היום עצמו) מודגש בצבע ההדגשה. -->
            <DataTemplate x:Key="ZmanRowTemplate">
                <Border x:Name="Row" CornerRadius="4" Padding="10,5" Background="Transparent">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="NameText" Grid.Column="0" Text="{Binding Name}" VerticalAlignment="Center"
                                   TextTrimming="CharacterEllipsis" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                        <TextBlock x:Name="TimeText" Grid.Column="1" Text="{Binding DisplayTime}" VerticalAlignment="Center"
                                   FontWeight="SemiBold" Margin="12,0,0,0" Foreground="{DynamicResource PrimaryForegroundBrush}" />
                    </Grid>
                </Border>
                <DataTemplate.Triggers>
                    <DataTrigger Binding="{Binding IsNext}" Value="True">
                        <Setter TargetName="Row" Property="Background" Value="{DynamicResource InfoBarBrush}" />
                        <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                        <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                        <Setter TargetName="TimeText" Property="Foreground" Value="{DynamicResource AccentForegroundBrush}" />
                    </DataTrigger>
                </DataTemplate.Triggers>
            </DataTemplate>
        </ResourceDictionary>
    </Window.Resources>

    <!-- החלון בגודל קבוע (כל הגובה הפנוי מעל הוידג'ט) והמשטח צמוד לתחתיתו. כך שינוי תוכן
         (יום אחר, פתיחת לוח השנה) רק מצייר מחדש, בלי להזיז או לשנות את גודל החלון - שזה מה
         שגרם לריצוד. האזור השקוף שמעל המשטח לא תופס לחיצות (חלון שכבתי מעביר אותן הלאה).
         השוליים סביב המשטח שומרים מקום לצל; PositionAboveWidget מקזז אותם. -->
    <Border x:Name="Surface" Style="{StaticResource FlyoutSurfaceStyle}" Margin="12" VerticalAlignment="Bottom">
        <!-- הרשימה היא הילד האחרון ולכן מקבלת את מה שנשאר: אם אין מספיק מקום היא נגללת. -->
        <DockPanel Width="320" Margin="0,0,0,2" LastChildFill="True">

            <!-- כותרת: ניווט בין ימים. ב-RTL "יום קודם" מימין והחץ פונה ימינה. -->
            <Grid DockPanel.Dock="Top" Margin="10,12,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="PrevDayButton" Style="{StaticResource SubtleIconButtonStyle}" VerticalAlignment="Top"
                        Content="&#xE76C;" FontSize="12" Click="PrevDayButton_Click"
                        ToolTip="יום קודם" AutomationProperties.Name="יום קודם" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Center" Margin="4,0">
                    <TextBlock x:Name="DayHeaderText" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                               FontSize="15" FontWeight="SemiBold" />
                    <TextBlock x:Name="HebrewDateHeaderText" HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="13.5" Margin="0,3,0,0" />
                    <TextBlock x:Name="GregorianDateHeaderText" HorizontalAlignment="Center" TextAlignment="Center"
                               FontSize="12" Margin="0,1,0,0" Foreground="{DynamicResource SecondaryForegroundBrush}" />
                    <Border x:Name="HolidayChip" Background="{DynamicResource InfoBarBrush}" CornerRadius="10"
                            Padding="10,3" Margin="0,7,0,0" HorizontalAlignment="Center" Visibility="Collapsed">
                        <TextBlock x:Name="HolidayHeaderText" TextAlignment="Center" TextWrapping="Wrap" FontSize="11.5"
                                   FontWeight="SemiBold" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="2" x:Name="NextDayButton" Style="{StaticResource SubtleIconButtonStyle}" VerticalAlignment="Top"
                        Content="&#xE76B;" FontSize="12" Click="NextDayButton_Click"
                        ToolTip="יום הבא" AutomationProperties.Name="יום הבא" />
            </Grid>

            <!-- שורת פעולות: חזרה להיום (ימין), ובצד השני לוח שנה, ערכת נושא והגדרות -->
            <Grid DockPanel.Dock="Top" Margin="10,0,10,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" x:Name="TodayButton" Style="{StaticResource SubtleTextButtonStyle}"
                        Click="TodayButton_Click" Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="&#xE8D1;" FontFamily="{StaticResource IconFont}" FontSize="12" VerticalAlignment="Center"
                                   Foreground="{DynamicResource AccentForegroundBrush}" Margin="0,0,6,0" />
                        <TextBlock Text="חזרה להיום" VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" />
                    </StackPanel>
                </Button>

                <ToggleButton Grid.Column="2" x:Name="DatePickerButton" Style="{StaticResource SubtleIconButtonStyle}"
                              Content="&#xE787;" Click="DatePickerButton_Click"
                              ToolTip="לוח שנה" AutomationProperties.Name="לוח שנה" />
                <Button Grid.Column="3" x:Name="ThemeToggleButton" Style="{StaticResource SubtleIconButtonStyle}"
                        Click="ThemeToggleButton_Click" Margin="2,0,0,0" />
                <Button Grid.Column="4" x:Name="SettingsButton" Style="{StaticResource SubtleIconButtonStyle}"
                        Content="&#xE713;" Click="SettingsButton_Click" Margin="2,0,0,0"
                        ToolTip="הגדרות" AutomationProperties.Name="הגדרות" />
            </Grid>

            <!-- לוח שנה עברי / לועזי - נפתח מכפתור לוח השנה -->
            <Border x:Name="DatePickerHost" DockPanel.Dock="Top" Style="{StaticResource InsetCardStyle}" Padding="8,10,8,8"
                    Margin="12,0,12,10" Visibility="Collapsed">
                <controls:HebrewCalendarPicker x:Name="HebrewDatePicker"
                                               DateSelected="HebrewDatePicker_DateSelected"
                                               ModeChanged="HebrewDatePicker_ModeChanged" />
            </Border>

            <TextBlock DockPanel.Dock="Top" Text="זמני היום" FontSize="12" FontWeight="SemiBold" Margin="16,0,16,6"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" />

            <TextBlock DockPanel.Dock="Bottom" Text="הזמנים משוערים לפי חישוב אסטרונומי, אין לסמוך על הזמנים להלכה למעשה."
                       FontSize="10.5" TextWrapping="Wrap" TextAlignment="Center" Margin="16,10,16,10"
                       Foreground="{DynamicResource SecondaryForegroundBrush}" />

            <Border Style="{StaticResource InsetCardStyle}" Padding="4" Margin="12,0">
                <ScrollViewer x:Name="ZmanimScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <ItemsControl x:Name="ZmanimList" ItemTemplate="{StaticResource ZmanRowTemplate}"
                                  AutomationProperties.Name="זמני היום" />
                </ScrollViewer>
            </Border>
        </DockPanel>
    </Border>
</Window>
