<Window x:Class="HebrewTaskbarWidget.ZmanEditDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="עריכת זמן"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="NoResize"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        ShowInTaskbar="False"
        Topmost="True"
        UseLayoutRounding="True"
        FontFamily="{DynamicResource UiFont}"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <!-- אותה ערכת עיצוב כמו חלון ההגדרות; הצבעים מוחלים בקוד לפי מצב התצוגה של ההגדרות. -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HebrewTaskbarWidget;component/Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Style="{StaticResource FlyoutSurfaceStyle}" Margin="16" Width="380">
        <StackPanel>
            <StackPanel Margin="22,20,22,18">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="15" TextWrapping="Wrap" />

                <TextBlock Text="שם מותאם אישית" Style="{StaticResource FieldLabel}" Margin="0,16,0,4" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox x:Name="CustomNameTextBox" Grid.Column="0" Height="32" Margin="0" />
                    <Button x:Name="PrimaryDeleteButton" Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                            Style="{StaticResource IconActionButtonStyle}" Width="32" Height="32" Margin="8,0,0,0"
                            ToolTip="מחיקת השורה הזו (השורה הכפולה תישאר לבד)" AutomationProperties.Name="מחיקת השורה"
                            Visibility="Collapsed" Click="PrimaryDeleteButton_Click" />
                </Grid>
                <TextBlock x:Name="PrimaryMethodText" Style="{StaticResource DescriptionText}" Margin="0,6,0,0" Visibility="Collapsed" />
                <TextBlock x:Name="PrimaryTimeText" Style="{StaticResource DescriptionText}" Margin="0,2,0,0" />

                <!-- לזמנים רגילים (לא הדלקת נרות) -->
                <StackPanel x:Name="MethodPanel" Margin="0,14,0,0">
                    <TextBlock Text="שיטת חישוב" Style="{StaticResource FieldLabel}" />
                    <ComboBox x:Name="MethodComboBox" HorizontalAlignment="Stretch" SelectionChanged="MethodComboBox_SelectionChanged">
                        <ComboBoxItem Content="השיטה הכללית" />
                        <ComboBoxItem Content="רגילה (זווית שמש)" />
                        <ComboBoxItem Content="72 דקות זמניות" />
                    </ComboBox>
                </StackPanel>

                <!-- רק להדלקת נרות -->
                <StackPanel x:Name="CandleLightingMinutesPanel" Orientation="Horizontal" Margin="0,14,0,0">
                    <TextBlock Text="דקות לפני השקיעה" VerticalAlignment="Center" />
                    <TextBox x:Name="CandleLightingMinutesTextBox" Width="52" Margin="10,0,0,0" MaxLength="2" TextAlignment="Center" />
                </StackPanel>

                <!-- רק לצאת הכוכבים -->
                <StackPanel x:Name="TzeitMinutesPanel" Margin="0,14,0,0">
                    <TextBlock Text="דקות אחרי שקיעת החמה (ריק = לפי שיטת החישוב)" Style="{StaticResource FieldLabel}" TextWrapping="Wrap" />
                    <TextBox x:Name="TzeitMinutesTextBox" Width="64" HorizontalAlignment="Left" TextAlignment="Center" />
                </StackPanel>

                <!-- זמן כפול - לא להדלקת נרות -->
                <StackPanel x:Name="DuplicateSectionPanel" Margin="0,16,0,0">
                    <Border BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="0,1,0,0" Margin="0,0,0,14" />

                    <CheckBox x:Name="DuplicateToggle" Content="שורת זמן כפולה" Style="{StaticResource ToggleSwitchStyle}"
                              HorizontalAlignment="Left"
                              Checked="DuplicateToggle_CheckedChanged" Unchecked="DuplicateToggle_CheckedChanged" />

                    <StackPanel x:Name="DuplicateDetailsPanel" Margin="0,12,0,0">
                        <TextBlock Text="שם השורה הכפולה" Style="{StaticResource FieldLabel}" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="DuplicateNameTextBox" Grid.Column="0" Height="32" Margin="0" />
                            <Button x:Name="DeleteDuplicateButton" Grid.Column="1" Content="&#xE74D;" FontFamily="{StaticResource IconFont}"
                                    Style="{StaticResource IconActionButtonStyle}" Width="32" Height="32" Margin="8,0,0,0"
                                    ToolTip="מחיקת השורה הכפולה" AutomationProperties.Name="מחיקת השורה הכפולה"
                                    Click="DeleteDuplicateButton_Click" />
                        </Grid>
                        <TextBlock x:Name="DuplicateMethodText" Style="{StaticResource DescriptionText}" Margin="0,6,0,0" />
                        <TextBlock x:Name="DuplicateTimeText" Style="{StaticResource DescriptionText}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>
            </StackPanel>

            <!-- כפתורים בתחתית, כמו בחלון ההגדרות -->
            <Border BorderThickness="0,1,0,0" CornerRadius="0,0,8,8"
                    BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource FooterBackgroundBrush}">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Left" Margin="22,12">
                    <Button x:Name="SaveButton" Content="שמירה" Style="{StaticResource PrimaryActionButtonStyle}" IsDefault="True"
                            Margin="0" Click="SaveButton_Click" />
                    <Button x:Name="CancelButton" Content="ביטול" Style="{StaticResource ActionButtonStyle}"
                            Margin="8,0,0,0" Click="CancelButton_Click" />
                </StackPanel>
            </Border>
        </StackPanel>
    </Border>
</Window>
