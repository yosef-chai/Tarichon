<Window x:Class="HebrewTaskbarWidget.AppMessageBoxWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="תאריכון"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="CenterOwner"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        FontSize="12.5"
        TextOptions.TextFormattingMode="Display"
        KeyDown="Window_KeyDown">

    <!-- אותה ערכת עיצוב כמו חלון ההגדרות (כפתורים, פס גלילה, צבעים) -->
    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HebrewTaskbarWidget;component/Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Window.Resources>

    <Border x:Name="RootBorder" Style="{StaticResource FlyoutSurfaceStyle}" Margin="16"
            MinWidth="340" MaxWidth="440">
        <StackPanel>
            <StackPanel Margin="24,22,24,10">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <TextBlock x:Name="IconText" FontFamily="{StaticResource IconFont}" FontSize="20" Margin="0,0,10,0"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentForegroundBrush}" />
                    <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"
                               TextAlignment="Center" TextWrapping="Wrap" />
                </StackPanel>

                <!-- במצב "גלילה גדולה" (מה חדש) מקבל MaxHeight בקוד והופך לאזור גלילה.
                     בכוונה TextBlock עם Inlines ולא FlowDocument, ששובר יישור RTL. -->
                <ScrollViewer x:Name="MessageScrollViewer" Margin="0,14,0,0"
                              VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <TextBlock x:Name="MessageTextBlock" TextWrapping="Wrap" TextAlignment="Center" FontSize="12.5" LineHeight="19"
                               Foreground="{DynamicResource SecondaryForegroundBrush}" />
                </ScrollViewer>
            </StackPanel>

            <Border x:Name="ButtonAreaBorder" BorderThickness="0,1,0,0" CornerRadius="0,0,8,8"
                    BorderBrush="{DynamicResource CardBorderBrush}" Background="{DynamicResource FooterBackgroundBrush}">
                <StackPanel x:Name="ButtonsPanel" Orientation="Horizontal" HorizontalAlignment="Center" Margin="16,14" />
            </Border>
        </StackPanel>
    </Border>
</Window>
