<Window x:Class="HebrewTaskbarWidget.ToastNotificationWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="התראת זמן היום"
        FlowDirection="RightToLeft"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Topmost="True"
        SizeToContent="WidthAndHeight"
        WindowStartupLocation="Manual"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True"
        FontFamily="{DynamicResource UiFont}"
        TextOptions.TextFormattingMode="Display"
        Focusable="False">

    <Window.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/HebrewTaskbarWidget;component/Themes/SettingsTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <Storyboard x:Key="FadeInStoryboard">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="0" To="1" Duration="0:0:0.25" />
            </Storyboard>
            <Storyboard x:Key="FadeOutStoryboard" Completed="FadeOutStoryboard_Completed">
                <DoubleAnimation Storyboard.TargetProperty="Opacity" From="1" To="0" Duration="0:0:0.4" />
            </Storyboard>
        </ResourceDictionary>
    </Window.Resources>

    <!-- השוליים שומרים מקום לצל של המשטח -->
    <Border x:Name="ToastBorder"
            Style="{StaticResource FlyoutSurfaceStyle}"
            Margin="12"
            Padding="14,10"
            MouseLeftButtonUp="Border_MouseLeftButtonUp"
            Cursor="Hand">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button x:Name="SnoozeButton" Grid.Column="0" VerticalAlignment="Top"
                    Style="{StaticResource SubtleIconButtonStyle}" Width="28" Height="28" FontSize="13"
                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                    Content="&#xE916;" Click="SnoozeButton_Click" AutomationProperties.Name="נודניק" />

            <StackPanel Grid.Column="1" Width="232" Margin="6,4,6,4" VerticalAlignment="Center">
                <TextBlock x:Name="TitleText" FontSize="11" FontWeight="SemiBold" TextAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SecondaryForegroundBrush}" Visibility="Collapsed" />
                <TextBlock x:Name="MessageText" FontSize="13" TextWrapping="Wrap" TextAlignment="Center" HorizontalAlignment="Center"
                           Margin="0,2,0,0" Foreground="{DynamicResource PrimaryForegroundBrush}" />
            </StackPanel>

            <Button x:Name="CloseButton" Grid.Column="2" VerticalAlignment="Top"
                    Style="{StaticResource SubtleIconButtonStyle}" Width="28" Height="28" FontSize="11"
                    Foreground="{DynamicResource SecondaryForegroundBrush}"
                    Content="&#xE711;" Click="CloseButton_Click" ToolTip="סגירה" AutomationProperties.Name="סגירה" />
        </Grid>
    </Border>
</Window>
